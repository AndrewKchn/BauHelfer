# Copy this file to .env and fill in the values. Never commit .env.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Optional. True shows detailed error pages. Default: True locally, always False in production.
DEBUG=True

# Required. Database connection URL.
# Local SQLite (works without installing anything):  sqlite:///db.sqlite3
# PostgreSQL (from the next ticket):                  postgres://user:password@localhost:5432/bauhelfer
DATABASE_URL=sqlite:///db.sqlite3

# Production only. Comma-separated host names the site may be served on.
ALLOWED_HOSTS=
