# Copy this file to .env and fill in the values. Never commit .env.

# Required. Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me

# Optional. True shows detailed error pages. Default: True locally, always False in production.
DEBUG=True

# Required. Database connection URL.
# Matches the PostgreSQL container from docker-compose.yml (start it with: docker compose up -d).
DATABASE_URL=postgres://bauhelfer:bauhelfer@localhost:5432/bauhelfer

# Production only. Comma-separated host names the site may be served on.
ALLOWED_HOSTS=

# Production only (#64): where uploaded job photos are stored, a Supabase Storage bucket via
# its S3 protocol. Locally photos go to media/ and these stay empty. Values in Supabase:
# Storage -> Settings -> S3 Connection. The key pair is a secret: Render asks for it.
MEDIA_S3_ENDPOINT_URL=
MEDIA_S3_REGION=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_BUCKET=job-photos
# The public address of the bucket, without https://, e.g.
# <project-ref>.supabase.co/storage/v1/object/public/job-photos
MEDIA_PUBLIC_URL=
